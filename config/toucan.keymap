#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Layer indices
#define BASE   0
#define BUTTON 1
#define NAV    2
#define MOUSE  3
#define MEDIA  4
#define NUM    5
#define SYM    6
#define FUN    7

// Key position groups (42-key matrix; outer pinky columns absent on 36-key)
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

// Hyper = Shift+Ctrl+Alt+Cmd; same chord Karabiner sends for Caps Lock
#define HYPER LS(LC(LA(LGUI)))

/ {
    behaviors {
        // Home row mods, left hand: triggered by right-hand keys only
        // Config B: balanced + small idle guard, tuned for fast typing with shortcut-heavy use
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mods, right hand: triggered by left-hand keys only
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Bottom-row layer-tap, left (Z = BUTTON layer on hold)
        ltl: layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Bottom-row layer-tap, right (/ = BUTTON layer on hold)
        ltr: layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Thumb layer-tap (no positional filter)
        thumb_lt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Double-tap to enter bootloader; single tap = no-op
        u_bootloader: u_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&bootloader>;
        };

        // Tap = caps_word, Shift+tap = caps_lock
        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // BT profile select; Shift+tap = clear all pairings
        u_bt_sel_0: u_bt_sel_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR_ALL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_1: u_bt_sel_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR_ALL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_2: u_bt_sel_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR_ALL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_3: u_bt_sel_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_CLR_ALL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Tap = toggle BLE/USB output, Shift+tap = force USB
        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&out OUT_TOG>, <&out OUT_USB>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&none  &kp Q          &kp W         &kp F          &kp P           &kp B            &kp J     &kp L          &kp U          &kp Y           &kp SQT           &none
&none  &hml LGUI A    &hml LALT R   &hml LCTRL S   &hml LSHFT T    &hml HYPER G     &hmr HYPER M   &hmr LSHFT N   &hmr LCTRL E   &hmr LALT I     &hmr LGUI O       &none
&none  &ltl BUTTON Z  &hml RALT X   &kp C          &kp D           &kp V            &kp K     &kp H          &kp COMMA      &hmr RALT DOT   &ltr BUTTON FSLH  &none
                      &thumb_lt MEDIA ESC  &thumb_lt NAV SPACE  &thumb_lt MOUSE TAB    &thumb_lt SYM RET  &thumb_lt NUM BSPC  &thumb_lt FUN DEL
            >;
        };

        button {
            display-name = "Button";
            bindings = <
&none  &none     &none     &none      &none      &none        &none     &none      &none      &none     &none     &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none        &none     &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&none  &none     &kp RALT  &none      &none      &none        &none     &none      &none      &kp RALT  &none     &none
                           &mkp MB3   &mkp MB1   &mkp MB2     &mkp MB2  &mkp MB1   &mkp MB3
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&none  &u_bootloader   &none     &none      &none      &none        &none         &none      &none      &none      &none      &none
&none  &kp LGUI        &kp LALT  &kp LCTRL  &kp LSHFT  &kp HYPER    &u_caps_word  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&none  &studio_unlock  &kp RALT  &none      &none      &none        &kp INS       &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                                 &none      &none      &none        &kp RET       &kp BSPC   &kp DEL
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&none  &u_bootloader  &none     &none      &none      &none        &none     &none           &none           &none         &none            &none
&none  &kp LGUI       &kp LALT  &kp LCTRL  &kp LSHFT  &kp HYPER    &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none          &kp RALT  &none      &none      &none        &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                                &none      &none      &none        &mkp MB2  &mkp MB1        &mkp MB3
            >;
        };

        media {
            display-name = "Media";
            bindings = <
&none  &u_bootloader  &none     &none      &none      &none        &none       &none        &none         &none         &none        &none
&none  &kp LGUI       &kp LALT  &kp LCTRL  &kp LSHFT  &kp HYPER    &none       &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT   &none
&none  &none          &kp RALT  &none      &none      &none        &u_out_tog  &u_bt_sel_0  &u_bt_sel_1   &u_bt_sel_2   &u_bt_sel_3  &none
                                &none      &none      &none        &kp C_STOP  &kp C_PP     &kp C_MUTE
            >;
        };

        num {
            display-name = "Num";
            bindings = <
&none  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT       &none  &none      &none      &none     &u_bootloader  &none
&none  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL      &kp HYPER  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI       &none
&none  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH       &none  &none      &none      &kp RALT  &none          &none
                          &kp DOT  &kp N0  &kp MINUS      &none  &none      &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&none  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC       &none  &none      &none      &none     &u_bootloader  &none
&none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS       &kp HYPER  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI       &none
&none  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE       &none  &none      &none      &kp RALT  &none          &none
                            &kp LPAR   &kp RPAR   &kp UNDER      &none  &none      &none
            >;
        };

        fun {
            display-name = "Fun";
            bindings = <
&none  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &none  &none      &none      &none     &u_bootloader  &none
&none  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK           &kp HYPER  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI       &none
&none  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &none  &none      &none      &kp RALT  &none          &none
                        &kp K_APP  &kp SPACE  &kp TAB            &none  &none      &none
            >;
        };

        extra_1 {
            status = "reserved";
            display-name = "Extra 1";
        };

        extra_2 {
            status = "reserved";
            display-name = "Extra 2";
        };

        extra_3 {
            status = "reserved";
            display-name = "Extra 3";
        };
    };
};
